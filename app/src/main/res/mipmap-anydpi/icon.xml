        android:fillColor="#FFF8ED" />
    <!--
         Seule la marque est reduite, le fond garde sa taille pleine. Ce vector est plein cadre (pas
         un adaptive-icon) : la tuile visible est le fond, large de 92 unites, contre 72 pour la zone
         visible de l'adaptive-icon. Pour rendre la meme proportion qu'en API >= 26 (marque a ~70% de
         la tuile) le facteur est donc 0.92 ici, et non le 0.72 des drawables de lanceur.
         Bbox resultante : 64.4 x 63.5 unites, centree sur (54,54).
    -->
    <group
        android:pivotX="55.5"
        android:pivotY="53"
        android:scaleX="0.92"
        android:scaleY="0.92"
        android:translateX="-1.5"
        android:translateY="1">
