<?xml version="1.0" encoding="utf-8"?><!--
   Backup / transfer rules for API 31+ (see backup_rules.xml for API 30 and below).
   device-transfer is spelled out on purpose: an omitted section means "transfer everything".
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- files/datastore/umihi-mobile.preferences_pb: encrypted YouTube cookie + data-sync id.
             Its AES key is a non-exportable Android Keystore key, so a restored copy can never
             be decrypted. Other settings share the same file and are excluded with it. -->
        <exclude domain="file" path="datastore" />
        <!-- Downloaded audio + thumbnails: gigabytes against a 25 MB backup quota. -->
        <exclude domain="file" path="downloads" />
        <!-- Room DB: song rows point at files/downloads paths that are not restored. -->
        <exclude domain="database" path="umihi-music" />
        <exclude domain="database" path="umihi-music-wal" />
        <exclude domain="database" path="umihi-music-shm" />
        <exclude domain="database" path="umihi-music-journal" />
    </cloud-backup>
    <!-- Same exclusions as cloud-backup: a direct device-to-device transfer copies data files but
         not Keystore material (the key is generated in the TEE and cannot be exported), so the
         session is just as undecryptable there, and the download paths are just as dangling. -->
    <device-transfer>
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="downloads" />
        <exclude domain="database" path="umihi-music" />
        <exclude domain="database" path="umihi-music-wal" />
        <exclude domain="database" path="umihi-music-shm" />
        <exclude domain="database" path="umihi-music-journal" />
    </device-transfer>
</data-extraction-rules>