<?xml version="1.0" encoding="utf-8"?>
<!--
     Variante de ic_jelyvo_foreground reservee a l'icone de lanceur (adaptive-icon).
     Memes pathData que le drawable d'origine, mais la marque est reduite via un <group> pour tenir
     dans la safe zone de 66dp : la bbox traits inclus passe de 70x69 a 50.4x49.7 unites, recentree
     sur (54,54). Le drawable d'origine reste intact car il sert aussi d'image dans l'UI (HomeScreen,
     splash screen) ou il doit rester pleine taille.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Pivot place sur le centre reel de la marque (55.5 ; 53) : les translations restent valables
         quel que soit le facteur d'echelle choisi -->
    <group
        android:pivotX="55.5"
        android:pivotY="53"
        android:scaleX="0.72"
        android:scaleY="0.72"
        android:translateX="-1.5"
        android:translateY="1">
        <path
            android:pathData="M72,25 C79,25 84,30 84,37 L84,60 C84,73 76,81 63,81 L56,81"
            android:fillColor="@android:color/transparent"
            android:strokeColor="#74304F"
            android:strokeWidth="13"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M51,38 L45,38 C34,38 27,46 27,57 C27,70 36,79 49,79 C59,79 66,72 66,62 L66,38"
            android:fillColor="@android:color/transparent"
            android:strokeColor="#F47B67"
            android:strokeWidth="13"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M66,51 L66,62 C66,72 59,79 49,79"
            android:fillColor="@android:color/transparent"
            android:strokeColor="#4774304F"
            android:strokeWidth="4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
